// ===================== WALLET =====================
async function connectWallet() {
  const btn = document.getElementById('walletBtn');
  if (myAddress) {
    myAddress = null;
    wallet = null;
    btn.textContent = 'CONNECT';
    btn.classList.remove('connected');
    document.getElementById('xpBanner').style.display = 'none';
    document.getElementById('contractAddr').textContent = 'Not connected';
    showToast('Wallet disconnected', 'info');
    return;
  }

  if (typeof window.ethereum === 'undefined') {
    showToast('No wallet detected. Install MetaMask or use WalletConnect.', 'error');
    return;
  }

  try {
    btn.textContent = 'Connecting...';
    const accounts = await window.ethereum.request({ method: 'eth_requestAccounts' });
    myAddress = accounts[0];
    wallet = window.ethereum;

    const short = myAddress.slice(0,6) + '...' + myAddress.slice(-4);
    btn.textContent = short;
    btn.classList.add('connected');

    document.getElementById('xpBanner').style.display = 'flex';
    document.getElementById('contractAddr').textContent = CONTRACT_ADDRESS;

    await refreshMyStats();
    showToast('Wallet connected ✓', 'success');
  } catch(e) {
    btn.textContent = 'CONNECT';
    showToast('Connection rejected', 'error');
  }
}


<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>GEN ARENA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Syne:wght@400;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #050508;
    --surface: #0d0d14;
    --card: #12121c;
    --border: #1e1e30;
    --accent: #00ff88;
    --accent2: #7c3aed;
    --accent3: #f59e0b;
    --red: #ff3366;
    --text: #e8e8f0;
    --muted: #6b6b8a;
    --glow: 0 0 20px rgba(0,255,136,0.3);
    --glow2: 0 0 20px rgba(124,58,237,0.4);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

  body {
    font-family: 'Syne', sans-serif;
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    overflow-x: hidden;
    padding-bottom: 90px;
  }

  /* NOISE OVERLAY */
  body::before {
    content: '';
    position: fixed; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none; z-index: 0; opacity: 0.6;
  }

  /* HEADER */
  .header {
    position: sticky; top: 0; z-index: 100;
    padding: 16px 20px 12px;
    background: linear-gradient(180deg, #050508 70%, transparent);
    display: flex; align-items: center; justify-content: space-between;
  }

  .logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 28px;
    letter-spacing: 4px;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .wallet-btn {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px;
    font-weight: 600;
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--accent);
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.5px;
  }
  .wallet-btn.connected {
    border-color: var(--accent);
    box-shadow: var(--glow);
  }
  .wallet-btn:active { transform: scale(0.96); }

  /* XP BANNER */
  .xp-banner {
    margin: 0 16px 20px;
    padding: 16px 20px;
    background: linear-gradient(135deg, rgba(124,58,237,0.15), rgba(0,255,136,0.08));
    border: 1px solid rgba(124,58,237,0.3);
    border-radius: 16px;
    display: flex; align-items: center; gap: 16px;
  }
  .xp-orb {
    width: 52px; height: 52px;
    border-radius: 50%;
    background: conic-gradient(var(--accent) 0deg, var(--accent2) 180deg, var(--accent) 360deg);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 11px; letter-spacing: 1px;
    color: var(--bg); flex-shrink: 0;
    animation: spin-slow 6s linear infinite;
    box-shadow: var(--glow);
  }
  @keyframes spin-slow { to { transform: rotate(360deg); } }
  .xp-info { flex: 1; }
  .xp-label { font-size: 10px; letter-spacing: 2px; color: var(--muted); text-transform: uppercase; }
  .xp-val { font-family: 'Bebas Neue', sans-serif; font-size: 32px; color: var(--accent); line-height: 1; }
  .wins-tag {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px; color: var(--accent3);
    background: rgba(245,158,11,0.12);
    border: 1px solid rgba(245,158,11,0.3);
    padding: 4px 10px; border-radius: 100px;
  }

  /* SECTION TITLE */
  .section-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 13px; letter-spacing: 4px;
    color: var(--muted); text-transform: uppercase;
    padding: 0 20px 10px;
  }

  /* TABS */
  .tabs {
    display: flex; gap: 8px;
    padding: 0 16px 20px;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    flex-shrink: 0;
    padding: 8px 18px;
    border-radius: 100px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--muted);
    font-size: 12px; font-weight: 700;
    letter-spacing: 1px; text-transform: uppercase;
    cursor: pointer; transition: all 0.2s;
  }
  .tab.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    box-shadow: var(--glow);
  }
  .tab:active { transform: scale(0.95); }

  /* PANELS */
  .panel { display: none; padding: 0 16px; }
  .panel.active { display: block; }

  /* SESSION CARD */
  .session-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 20px;
    margin-bottom: 14px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .session-card:active { border-color: var(--accent2); box-shadow: var(--glow2); }
  .session-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
    opacity: 0;
    transition: opacity 0.2s;
  }
  .session-card.live::before { opacity: 1; }
  .session-card.live { border-color: rgba(0,255,136,0.2); }

  .session-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 14px;
  }
  .session-id {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; color: var(--muted); letter-spacing: 1px;
  }
  .session-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px; color: var(--text); line-height: 1;
  }

  .status-pill {
    font-size: 9px; font-weight: 700; letter-spacing: 2px;
    text-transform: uppercase; padding: 4px 10px;
    border-radius: 100px;
  }
  .status-pill.live { background: rgba(0,255,136,0.15); color: var(--accent); border: 1px solid rgba(0,255,136,0.3); }
  .status-pill.waiting { background: rgba(245,158,11,0.12); color: var(--accent3); border: 1px solid rgba(245,158,11,0.25); }
  .status-pill.ended { background: rgba(107,107,138,0.12); color: var(--muted); border: 1px solid var(--border); }
  .status-pill.challenge { background: rgba(255,51,102,0.12); color: var(--red); border: 1px solid rgba(255,51,102,0.3); }

  .session-meta {
    display: grid; grid-template-columns: 1fr 1fr 1fr;
    gap: 10px; margin-bottom: 16px;
  }
  .meta-item { }
  .meta-label { font-size: 9px; letter-spacing: 1.5px; color: var(--muted); text-transform: uppercase; }
  .meta-val { font-family: 'JetBrains Mono', monospace; font-size: 16px; font-weight: 600; color: var(--text); }

  .session-actions { display: flex; gap: 8px; }

  /* BUTTONS */
  .btn {
    flex: 1; padding: 12px 8px;
    border-radius: 12px; border: none;
    font-family: 'Syne', sans-serif;
    font-weight: 700; font-size: 12px;
    letter-spacing: 0.5px;
    cursor: pointer; transition: all 0.2s;
    display: flex; align-items: center; justify-content: center; gap: 6px;
  }
  .btn:active { transform: scale(0.95); }
  .btn-primary { background: var(--accent); color: var(--bg); }
  .btn-primary:active { box-shadow: var(--glow); }
  .btn-secondary { background: rgba(124,58,237,0.2); color: #a78bfa; border: 1px solid rgba(124,58,237,0.3); }
  .btn-danger { background: rgba(255,51,102,0.15); color: var(--red); border: 1px solid rgba(255,51,102,0.25); }
  .btn-ghost { background: var(--surface); color: var(--muted); border: 1px solid var(--border); }
  .btn-full { width: 100%; padding: 16px; border-radius: 14px; font-size: 14px; }

  /* ROUND CARD */
  .round-card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 18px;
    margin-bottom: 12px;
  }
  .round-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 12px;
  }
  .round-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 18px; color: var(--text);
  }
  .prompt-box {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent2);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 14px;
    font-size: 13px; line-height: 1.6; color: var(--text);
    font-style: italic;
  }

  /* TEXTAREA */
  .submit-area {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 14px;
    width: 100%; min-height: 100px;
    color: var(--text); font-family: 'Syne', sans-serif;
    font-size: 13px; line-height: 1.6;
    resize: none; outline: none;
    transition: border-color 0.2s;
  }
  .submit-area:focus { border-color: var(--accent2); }

  /* INPUT */
  .input {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    width: 100%; color: var(--text);
    font-family: 'JetBrains Mono', monospace; font-size: 13px;
    outline: none; transition: border-color 0.2s;
    margin-bottom: 10px;
  }
  .input:focus { border-color: var(--accent2); }
  .input::placeholder { color: var(--muted); }
  .input-label { font-size: 11px; color: var(--muted); letter-spacing: 1px; margin-bottom: 6px; text-transform: uppercase; }

  /* LEADERBOARD ROW */
  .lb-row {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--border);
    transition: background 0.15s;
  }
  .lb-row:last-child { border-bottom: none; }
  .lb-row:active { background: rgba(255,255,255,0.02); }
  .lb-rank {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 22px; width: 32px; text-align: center;
    color: var(--muted);
  }
  .lb-rank.top { color: var(--accent3); }
  .lb-addr {
    flex: 1;
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px; color: var(--text);
  }
  .lb-xp {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 20px; color: var(--accent);
  }
  .lb-wins-badge {
    font-size: 10px; color: var(--accent3);
    background: rgba(245,158,11,0.12);
    border: 1px solid rgba(245,158,11,0.2);
    padding: 2px 8px; border-radius: 100px;
    white-space: nowrap;
  }

  /* CARD WRAPPER */
  .card {
    background: var(--card); border: 1px solid var(--border);
    border-radius: 20px; overflow: hidden; margin-bottom: 14px;
  }

  /* MODAL */
  .modal-overlay {
    position: fixed; inset: 0; z-index: 500;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(8px);
    display: none; align-items: flex-end; justify-content: center;
  }
  .modal-overlay.open { display: flex; }
  .modal {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 28px 28px 0 0;
    padding: 28px 20px 40px;
    width: 100%; max-width: 480px;
    max-height: 90vh; overflow-y: auto;
    animation: slide-up 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }
  .modal-handle {
    width: 40px; height: 4px;
    background: var(--border); border-radius: 100px;
    margin: 0 auto 20px;
  }
  .modal-title {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 24px; letter-spacing: 2px;
    margin-bottom: 20px;
    background: linear-gradient(135deg, var(--text), var(--muted));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* BOTTOM NAV */
  .bottom-nav {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;
    background: rgba(5,5,8,0.95);
    backdrop-filter: blur(20px);
    border-top: 1px solid var(--border);
    display: flex; padding: 12px 20px 24px;
    gap: 4px;
  }
  .nav-item {
    flex: 1; display: flex; flex-direction: column;
    align-items: center; gap: 4px;
    padding: 8px 4px; border-radius: 14px;
    cursor: pointer; transition: all 0.2s;
    color: var(--muted); font-size: 9px;
    font-weight: 700; letter-spacing: 1px;
    text-transform: uppercase;
  }
  .nav-item.active { color: var(--accent); background: rgba(0,255,136,0.08); }
  .nav-item:active { transform: scale(0.92); }
  .nav-icon { font-size: 20px; line-height: 1; }

  /* VOTE OPTION */
  .vote-option {
    background: var(--surface);
    border: 1.5px solid var(--border);
    border-radius: 14px; padding: 14px 16px;
    margin-bottom: 10px; cursor: pointer;
    transition: all 0.2s;
    font-family: 'JetBrains Mono', monospace; font-size: 12px;
    color: var(--text);
  }
  .vote-option.selected { border-color: var(--accent); background: rgba(0,255,136,0.08); color: var(--accent); box-shadow: var(--glow); }
  .vote-option:active { transform: scale(0.98); }

  /* PROGRESS BAR */
  .prog-bar-wrap { background: var(--surface); border-radius: 100px; height: 6px; overflow: hidden; }
  .prog-bar { height: 100%; border-radius: 100px; background: linear-gradient(90deg, var(--accent2), var(--accent)); transition: width 0.5s ease; }

  /* TOAST */
  .toast {
    position: fixed; top: 80px; left: 50%; transform: translateX(-50%);
    z-index: 1000; min-width: 240px; max-width: 90vw;
    padding: 12px 20px; border-radius: 14px;
    font-size: 13px; font-weight: 600; text-align: center;
    animation: toast-in 0.3s ease, toast-out 0.3s ease 2.5s forwards;
    pointer-events: none;
  }
  .toast.success { background: rgba(0,255,136,0.15); border: 1px solid rgba(0,255,136,0.3); color: var(--accent); }
  .toast.error { background: rgba(255,51,102,0.15); border: 1px solid rgba(255,51,102,0.3); color: var(--red); }
  .toast.info { background: rgba(124,58,237,0.15); border: 1px solid rgba(124,58,237,0.3); color: #a78bfa; }
  @keyframes toast-in { from { opacity: 0; transform: translateX(-50%) translateY(-10px); } to { opacity: 1; transform: translateX(-50%) translateY(0); } }
  @keyframes toast-out { to { opacity: 0; transform: translateX(-50%) translateY(-10px); } }

  /* LIVE DOT */
  .live-dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
    animation: pulse 1.5s ease infinite;
    display: inline-block; margin-right: 6px;
  }
  @keyframes pulse { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.5; transform: scale(0.8); } }

  /* DIVIDER */
  .divider { height: 1px; background: var(--border); margin: 16px 0; }

  /* EMPTY STATE */
  .empty {
    text-align: center; padding: 48px 20px;
    color: var(--muted); font-size: 13px; line-height: 1.8;
  }
  .empty-icon { font-size: 48px; margin-bottom: 12px; opacity: 0.4; }

  /* TOGGLE */
  .toggle-row {
    display: flex; align-items: center; justify-content: space-between;
    padding: 14px 0; border-bottom: 1px solid var(--border);
  }
  .toggle-label { font-size: 13px; color: var(--text); }
  .toggle-sub { font-size: 11px; color: var(--muted); }
  .toggle {
    width: 44px; height: 26px; border-radius: 100px;
    background: var(--border); position: relative; cursor: pointer;
    transition: background 0.2s; flex-shrink: 0;
  }
  .toggle.on { background: var(--accent); }
  .toggle::after {
    content: ''; position: absolute;
    width: 20px; height: 20px; border-radius: 50%;
    background: white; top: 3px; left: 3px;
    transition: transform 0.2s;
  }
  .toggle.on::after { transform: translateX(18px); }

  /* SPINNER */
  .spinner {
    width: 20px; height: 20px; border-radius: 50%;
    border: 2px solid rgba(255,255,255,0.1);
    border-top-color: var(--accent);
    animation: spin 0.8s linear infinite;
    display: inline-block;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .flex-center { display: flex; align-items: center; justify-content: center; gap: 8px; }

  /* CONTRACT ADDRESS */
  .contract-addr {
    font-family: 'JetBrains Mono', monospace;
    font-size: 11px; color: var(--muted);
    background: var(--surface); border: 1px solid var(--border);
    padding: 10px 14px; border-radius: 10px;
    word-break: break-all; line-height: 1.6;
  }

  .badge {
    font-size: 10px; font-weight: 700;
    padding: 3px 8px; border-radius: 100px; letter-spacing: 0.5px;
  }
  .badge-llm { background: rgba(124,58,237,0.2); color: #a78bfa; border: 1px solid rgba(124,58,237,0.3); }
  .badge-vote { background: rgba(0,255,136,0.1); color: var(--accent); border: 1px solid rgba(0,255,136,0.2); }
  .badge-appeal { background: rgba(255,51,102,0.1); color: var(--red); border: 1px solid rgba(255,51,102,0.25); }
</style>
</head>
<body>

<!-- HEADER -->
<div class="header">
  <div class="logo">GEN ARENA</div>
  <button class="wallet-btn" id="walletBtn" onclick="connectWallet()">CONNECT</button>
</div>

<!-- XP BANNER -->
<div class="xp-banner" id="xpBanner" style="display:none">
  <div class="xp-orb">XP</div>
  <div class="xp-info">
    <div class="xp-label">Your XP</div>
    <div class="xp-val" id="myXP">0</div>
  </div>
  <div>
    <div class="wins-tag" id="myWins">🏆 0 wins</div>
  </div>
</div>

<!-- TABS -->
<div class="tabs">
  <div class="tab active" onclick="switchTab('arena')">⚔️ Arena</div>
  <div class="tab" onclick="switchTab('round')">🎯 Round</div>
  <div class="tab" onclick="switchTab('vote')">🗳 Vote</div>
  <div class="tab" onclick="switchTab('leaderboard')">🏆 Board</div>
  <div class="tab" onclick="switchTab('create')">+ Create</div>
</div>

<!-- ========== ARENA TAB ========== -->
<div class="panel active" id="panel-arena">
  <div class="section-title">Active Sessions</div>

  <!-- Session 1 - Live -->
  <div class="session-card live">
    <div class="session-header">
      <div>
        <div class="session-id">SESSION</div>
        <div class="session-num">#001</div>
      </div>
      <div><span class="status-pill live"><span class="live-dot"></span>LIVE</span></div>
    </div>
    <div class="session-meta">
      <div class="meta-item">
        <div class="meta-label">Players</div>
        <div class="meta-val">4/8</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Round</div>
        <div class="meta-val">2</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Bond</div>
        <div class="meta-val">50xp</div>
      </div>
    </div>
    <div style="margin-bottom:12px; display:flex; gap:6px; flex-wrap:wrap;">
      <span class="badge badge-llm">🤖 LLM Judge</span>
      <span class="badge badge-vote">📊 Vote Mode</span>
    </div>
    <div class="session-actions">
      <button class="btn btn-primary" onclick="joinSession(1)">Join</button>
      <button class="btn btn-secondary" onclick="openRound(1)">View Round</button>
      <button class="btn btn-ghost" onclick="openChallenge(1)">⚡</button>
    </div>
  </div>

  <!-- Session 2 - Waiting -->
  <div class="session-card">
    <div class="session-header">
      <div>
        <div class="session-id">SESSION</div>
        <div class="session-num">#002</div>
      </div>
      <div><span class="status-pill waiting">WAITING</span></div>
    </div>
    <div class="session-meta">
      <div class="meta-item">
        <div class="meta-label">Players</div>
        <div class="meta-val">2/4</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Round</div>
        <div class="meta-val">0</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Bond</div>
        <div class="meta-val">100xp</div>
      </div>
    </div>
    <div style="margin-bottom:12px; display:flex; gap:6px;">
      <span class="badge badge-llm">🤖 LLM Prompts</span>
      <span class="badge badge-appeal">⚡ 300s appeal</span>
    </div>
    <div class="session-actions">
      <button class="btn btn-primary" onclick="joinSession(2)">Join</button>
      <button class="btn btn-ghost" onclick="loadSession(2)">Info</button>
    </div>
  </div>

  <!-- Session 3 - Challenge -->
  <div class="session-card">
    <div class="session-header">
      <div>
        <div class="session-id">SESSION</div>
        <div class="session-num">#003</div>
      </div>
      <div><span class="status-pill challenge"><span class="live-dot" style="background:var(--red);box-shadow:0 0 8px var(--red)"></span>CHALLENGE</span></div>
    </div>
    <div class="session-meta">
      <div class="meta-item">
        <div class="meta-label">Players</div>
        <div class="meta-val">6/6</div>
      </div>
      <div class="meta-item">
        <div class="meta-label">Round</div>
        <div class="meta-val">3</div>
      </div>

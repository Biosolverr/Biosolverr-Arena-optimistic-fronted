function closeModal(id) {
  document.getElementById(id).classList.remove('open');
}

function toggleSwitch(id) {
  document.getElementById(id).classList.toggle('on');
}

function selectVote(el, addr) {
  document.querySelectorAll('.vote-option').forEach(v => v.classList.remove('selected'));
  el.classList.add('selected');
  selectedVoteAddr = addr;
  const btn = document.getElementById('voteBtn');
  btn.disabled = false;
  btn.style.opacity = '1';
  btn.textContent = 'Cast Vote';
}

function showToast(msg, type = 'info') {
  const existing = document.querySelector('.toast');
  if (existing) existing.remove();
  const t = document.createElement('div');
  t.className = `toast ${type}`;
  t.textContent = msg;
  document.body.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}

function fakeDelay(ms = 1000) {
  return new Promise(r => setTimeout(r, ms));
}

function loadSession(id) {
  showToast(`Loading session #${id} info...`, 'info');
}

// Close modal on overlay click
document.querySelectorAll('.modal-overlay').forEach(overlay => {
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) overlay.classList.remove('open');
  });
});

// EVM account change listener
if (typeof window.ethereum !== 'undefined') {
  window.ethereum.on('accountsChanged', (accounts) => {
    if (accounts.length === 0) {
      myAddress = null;
      document.getElementById('walletBtn').textContent = 'CONNECT';
      document.getElementById('walletBtn').classList.remove('connected');
      document.getElementById('xpBanner').style.display = 'none';
    } else {
      myAddress = accounts[0];
      const short = myAddress.slice(0,6) + '...' + myAddress.slice(-4);
      document.getElementById('walletBtn').textContent = short;
    }
  });
